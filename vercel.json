    { "source": "/reparaciones/main-14038-reparacion-pantalla-navegador/", "destination": "/reparaciones/main-8674-reparacion-pantalla-tactil-multimedia/", "permanent": true },
    { "source": "/reparaciones/main-14038-reparacion-pantalla-navegador", "destination": "/reparaciones/main-8674-reparacion-pantalla-tactil-multimedia/", "permanent": true },
    { "source": "/reparaciones/main-8241-qubo-2/", "destination": "/reparaciones/main-8236-qubo/", "permanent": true },
    { "source": "/reparaciones/main-8241-qubo-2", "destination": "/reparaciones/main-8236-qubo/", "permanent": true },
